<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GovtPrep" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.GovtPrep.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.GovtPrep</item>
    </style>
</resources>
